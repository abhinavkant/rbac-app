{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authorization": "Information",
      "Rbac.Api.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "RbacDb": "Data Source=rbac.db"
  },

  "Jwt": {
    "Issuer": "rbac-app",
    "Audience": "rbac-app-clients",
    "SigningKey": "dev-only-signing-key-change-me-0123456789ABCDEF",
    "ExpirationInMinutes": 30
  },

  "Authorization": {
    "PermissionSource": "Token",
    "PermissionCacheDurationInSeconds": 60,
    "DisableCache": false
  }
}
