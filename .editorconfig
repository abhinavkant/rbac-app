# EditorConfig — https://editorconfig.org
#
# Style baseline for this solution. It describes the code that is already here, so that `dotnet format`
# is a no-op on a clean tree and a new file in a new IDE looks the same as an existing one.
#
# Severities used below:
#   error      - the compiler/analyzer stops the build
#   warning    - build warning; keep the tree at zero warnings
#   suggestion - IDE hint only; never fails a build
#   none       - explicitly turned off, with the reason in a comment
#
# What is actually enforced here, measured on this SDK rather than assumed:
#   * `EnforceCodeStyleInBuild` is set in Directory.Build.props, so the `csharp_style_*` / `dotnet_style_*`
#     options below are real build warnings: a block-scoped namespace (IDE0160) fails the build.
#   * `dotnet format` reads this file too, so `dotnet format --verify-no-changes` is a usable CI gate.
#   * The naming rules (the `dotnet_naming_*` blocks) are honoured by Rider, Visual Studio and VS Code, but
#     not by `dotnet build` — Roslyn's IDE1006 in a build only reports its built-in conventions (type
#     names). Naming violations therefore show up in the editor and in review, not in the build log.
root = true

# ---------------------------------------------------------------- file basics
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# XML, JSON, YAML, MSBuild and HTTP files read better with two-space indentation.
[*.{json,yml,yaml,xml,config,props,targets,csproj,http,slnx}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown, so never strip them.
[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120

# ---------------------------------------------------------------- layout
[*.cs]
# Allman braces: `if (x)\n{\n … \n}` - never `if (x) { … }` on one line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Braces are not optional: there is not one brace-less `if` in this solution.
csharp_prefer_braces = true:warning
csharp_preserve_single_line_blocks = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false

# Spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_dot = false
csharp_space_before_dot = false

# ---------------------------------------------------------------- usings and namespaces
[*.cs]
using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ---------------------------------------------------------------- `var`
# The type is spelled out when it carries information and left to `var` when the right-hand side already
# says it. That is the pattern in this codebase: `var order = new Order` next to
# `IReadOnlyList<string> knownRoles = await catalog.GetKnownRolesAsync(...)`.
[*.cs]
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types_with_complex_type = false:suggestion

# ---------------------------------------------------------------- members
[*.cs]
# Expression bodies wherever the body is a single expression.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# `this.` is never written in this codebase.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_readonly_attributes = true:suggestion
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# `new()` where the target type already says it.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_object_initializer = true:suggestion
csharp_prefer_simple_object_creation = true:suggestion

# ---------------------------------------------------------------- modern C#
[*.cs]
# Collection expressions (`[.. Permissions.All]`) rather than new List<T>.
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_require_collection_expression = false:none
dotnet_style_prefer_simplified_collection_expression = true:suggestion

# Pattern matching over type tests and `as` chains; switch expressions over long if/else ladders.
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_pattern_matching_over_is_with_null_check = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_when_patterns = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_system_text_json = true:suggestion

# Nullability and expression-style spellings.
dotnet_style_require_nullability_reference_types_annotation = warning:warning
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:none
dotnet_style_require_async_member_modifier = false:none

# ---------------------------------------------------------------- naming
# Public and protected surface: PascalCase. Private static helpers in this codebase are camelCase
# (`ToResponse`, `RequirementOf`), so they get their own rule. See the header note: these rules are for the
# editor, not for `dotnet build`.
dotnet_naming_symbols.types_and_namespaces.symbols = *
dotnet_naming_symbols.types_and_namespaces.applicable_kinds = class,interface,struct,enum,delegate,namespace
dotnet_naming_symbols.types_and_namespaces.applicable_accessibilities = *

dotnet_naming_rule.types_should_be_pascal_case.symbols = types_and_namespaces
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_should_be_pascal_case.severity = warning

dotnet_naming_symbols.public_and_protected_members.symbols = *
dotnet_naming_symbols.public_and_protected_members.applicable_kinds = property,method,event,field
dotnet_naming_symbols.public_and_protected_members.applicable_accessibilities = public,protected,protected_internal,private_protected

dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_and_protected_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_should_be_pascal_case.severity = warning

# Constants and static fields (the permission catalog, policy names, cache keys): PascalCase.
dotnet_naming_symbols.constants_and_static_fields.symbols = *
dotnet_naming_symbols.constants_and_static_fields.applicable_kinds = field
dotnet_naming_symbols.constants_and_static_fields.required_modifiers = const,static,readonly

dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants_and_static_fields
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning

# Private instance fields: _camelCase, the one convention the framework does not dictate.
dotnet_naming_symbols.private_instance_fields.symbols = *
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields.excluded_modifiers = static,const,readonly

dotnet_naming_rule.private_fields_should_be_camel_with_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.style = camel_case
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.required_prefix = _
dotnet_naming_rule.private_fields_should_be_camel_with_underscore.severity = warning

dotnet_naming_symbols.parameters.symbols = *
dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case
dotnet_naming_rule.parameters_should_be_camel_case.severity = warning

# Locals and lambda parameters are suggestion-only: `_` in a `foreach` is a perfectly good name and a
# build should not stop over it.
dotnet_naming_symbols.locals.symbols = *
dotnet_naming_symbols.locals.applicable_kinds = local

dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion

dotnet_naming_symbols.private_static_methods.symbols = *
dotnet_naming_symbols.private_static_methods.applicable_kinds = method
dotnet_naming_symbols.private_static_methods.applicable_accessibilities = private
dotnet_naming_symbols.private_static_methods.required_modifiers = static

dotnet_naming_rule.private_static_methods_should_be_camel_case.symbols = private_static_methods
dotnet_naming_rule.private_static_methods_should_be_camel_case.style = camel_case
dotnet_naming_rule.private_static_methods_should_be_camel_case.severity = suggestion

# ---------------------------------------------------------------- diagnostics
[*.cs]
# Formatting: the rule `dotnet format` enforces (IDE0055).
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0055.formatter_language = csharp

# Braces and file-scoped namespaces, restated as diagnostics so the IDE and the build agree.
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0160.severity = error
dotnet_diagnostic.IDE0161.severity = error

# Naming. Editor-enforced only; see the header note.
dotnet_diagnostic.IDE1006.severity = warning

# Collection expressions and other modern syntax: hint level, because the language moves faster than the
# code does.
dotnet_diagnostic.IDE0300.severity = suggestion # use a collection expression
dotnet_diagnostic.IDE0301.severity = suggestion # simplify a collection expression
dotnet_diagnostic.IDE0303.severity = suggestion # collection initialization can become a collection expression
dotnet_diagnostic.IDE0305.severity = suggestion # collection expression for a fluent chain

# Analyzer rules worth seeing in this sample, deliberately at hint level: they are advice about a demo API,
# not defects.
dotnet_diagnostic.CA1062.severity = suggestion # validate the arguments of public methods
dotnet_diagnostic.CA1707.severity = suggestion # identifiers should not contain underscores
dotnet_diagnostic.CA1848.severity = suggestion # use the LoggerMessage source generator
dotnet_diagnostic.CA2007.severity = none       # ConfigureAwait: meaningless in ASP.NET Core
dotnet_diagnostic.CA1303.severity = none       # do not pass literals as localized parameters
dotnet_diagnostic.CA1305.severity = none       # IFormatProvider: this project sets InvariantGlobalization
dotnet_diagnostic.CA1841.severity = none       # call LoggerMessage overloads

# Nothing here is auto-documented yet. To change that: set
# <GenerateDocumentationFile>true</GenerateDocumentationFile> in Directory.Build.props, then drop the next
# line; every public member in src/Rbac.Api/Authorization and src/Rbac.Api/Features is already documented.
dotnet_diagnostic.CS1591.severity = none

# ---------------------------------------------------------------- tests
[tests/**/*.cs]
# Test names are sentences, on purpose: `The_policy_for_a_permission_admits_a_caller_holding_it` says
# what broke when one fails. Naming rules are off here so those names are not flagged.
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
