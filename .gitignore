# Databases created at run time (the sample calls EnsureCreated() on startup).
# These are local state, never source: keep the schema in code instead.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db-journal

# Secrets and machine-local configuration
# NOTE: appsettings.Development.json in this sample only holds a development signing key and is meant
# to be committed. Real signing keys and connection strings belong in user secrets, an environment
# variable, or your secret store - never in a file you push.
*.pfx
*.p12
*.key
*.pem
*.secret.json
secrets.json
appsettings.Local.json
appsettings.*.Local.json
.env
.env.*
!.env.example

